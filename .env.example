# Local: `npm run db:start` runs an embedded Postgres server on this URL.
# Production: point at Neon / Supabase.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# Which tenant this deployment serves (Phase 1: the single seeded tenant).
TENANT_SLUG=abdul-saboor

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# Needed when self-hosting / `next start` locally; Vercel sets this automatically.
AUTH_TRUST_HOST=true

# Owner account + public contact address, used by `npm run db:seed`.
OWNER_EMAIL=
OWNER_PASSWORD=

# Optional: Resend for contact-form notifications. Without a key, notifications are logged to the server console.
RESEND_API_KEY=
NOTIFY_FROM="Portfolio <notifications@example.com>"
